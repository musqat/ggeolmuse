# 로컬 docker-compose 환경변수 템플릿.
#   cp .env.example .env   (또는 local-up.sh가 자동 복사)
# 모든 값에 동작하는 기본값이 있어 그대로 실행 가능

# AI 챗봇(선택): 키가 있으면 'docker compose --profile ai' 로 chat-service 활성.
OPENAI_API_KEY=

# 외부 설정 저장소 (public)
CONFIG_GIT_URI=https://github.com/musqat/ggeolmuse-config.git
CONFIG_GIT_LABEL=main

# 외부 시세 API 키(선택). 없으면 demo (제한적)
ALPHAVANTAGE_API_KEY=demo
KOREAEXIM_API_KEY=demo

# 메일(로컬은 인증 생략이라 미사용 더미)
MAIL_USERNAME=local@example.com
MAIL_PASSWORD=local-dummy

# Redis 비밀번호
REDIS_PASSWORD=localdev
