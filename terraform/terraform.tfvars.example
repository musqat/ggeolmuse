# terraform.tfvars 로 복사해서 채운다. tfvars 는 gitignore 대상이다.

# 필수 —— IAM 역할과 스케줄을 붙일 EC2
ec2_instance_id = "i-xxxxxxxxxxxxxxxxx"

# 선택 —— RDS 도 껐다 켤 때. 엔드포인트가 아니라 DB 식별자다
#   aws rds describe-db-instances --query "DBInstances[].DBInstanceIdentifier" --output text
# rds_instance_id = "ggeolmuse-db"

# 선택 —— 알람 수신 이메일. 넣으면 수신함에서 구독을 확인해야 한다
# alarm_email = "you@example.com"

# 기본값을 바꿀 때만
# scheduler_start_hour = 7
# scheduler_stop_hour  = 19
# rds_start_hour       = 6
# rds_start_minute     = 50
# rds_stop_hour        = 19
# rds_stop_minute      = 5
