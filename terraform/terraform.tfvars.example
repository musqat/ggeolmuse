# terraform.tfvars 로 복사해 채울 템플릿(tfvars 는 gitignore 대상)

# 필수 —— IAM 역할과 스케줄을 붙일 EC2
ec2_instance_id = "i-xxxxxxxxxxxxxxxxx"

# 선택 —— RDS 도 껐다 켤 때(엔드포인트가 아닌 DB 식별자)
#   aws rds describe-db-instances --query "DBInstances[].DBInstanceIdentifier" --output text
# rds_instance_id = "ggeolmuse-db"

# 선택 —— 알람 수신 이메일(수신함의 확인 링크를 누른 뒤부터 받음)
# alarm_email = "you@example.com"

# 선택 —— EC2 종료 알림을 받을 슬랙 웹훅(알람 채널과 같으면 ggeolmuse-secrets 의 SLACK_WEBHOOK_URL)
# slack_webhook_url = "https://hooks.slack.com/services/..."

# 기본값을 바꿀 때만
# scheduler_start_hour = 7
# scheduler_stop_hour  = 19
# rds_start_hour       = 6
# rds_start_minute     = 40
# rds_stop_hour        = 19
# rds_stop_minute      = 5
