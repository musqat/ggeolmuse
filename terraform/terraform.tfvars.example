# terraform.tfvars 로 복사해 채울 템플릿(tfvars 는 gitignore 대상)
# 값 찾는 명령과 순서는 README 의 "운영 자원 가져오기"

# 필수 —— 평일에 켜고 끌 k8s 노드 셋(이름 → 인스턴스 id, k8s/terraform 의 terraform output node_ids)
scheduled_instances = {
  control-plane = "i-xxxxxxxxxxxxxxxxx"
  worker-a      = "i-xxxxxxxxxxxxxxxxx"
  worker-b      = "i-xxxxxxxxxxxxxxxxx"
}

# 월간 덤프를 쓸 역할(k8s/terraform 의 terraform output node_role_name)
db_backup_writer_roles = ["ggeolmuse-k8s-node"]

# 선택 —— RDS 도 가져오고 껐다 켤 때(엔드포인트가 아닌 DB 식별자)
# rds_instance_id          = "ggeolmuse-postgres"
# rds_allocated_storage    = 20
# rds_storage_type         = "gp2"
# rds_storage_encrypted    = true
# rds_publicly_accessible  = false
# rds_subnet_group_name    = "..."
# rds_security_group_ids   = ["sg-xxxxxxxxxxxxxxxxx"]
# rds_parameter_group_name = "default.postgres15"
# rds_max_allocated_storage        = 1000   # 저장 공간 자동 늘리기 상한(0 이면 끔)
# rds_performance_insights_enabled = true

# 선택 —— 알람 수신 이메일(수신함의 확인 링크를 누른 뒤부터 받음)
# alarm_email = "you@example.com"

# 선택 —— EC2 종료 알림 · 사이트 확인 알림을 받을 슬랙 웹훅(비우면 둘 다 만들지 않음, 알람 채널과 같으면 ggeolmuse-secrets 의 SLACK_WEBHOOK_URL)
# slack_webhook_url = "https://hooks.slack.com/services/..."

# 선택 —— 가동 시간에 5분마다 AWS 에서 확인할 주소(기본은 프론트 · 시세 API · /auth, slack_webhook_url 이 있을 때만 만듦)
# uptime_check_urls = {
#   frontend = "https://ggeolmuse.com/"
#   price    = "https://ggeolmuse.com/api/market/price/AAPL"
#   auth     = "https://ggeolmuse.com/auth/realms/muscathan"
# }

# 선택 —— PR 의 읽기 전용 plan 역할(README 의 "PR 의 읽기 전용 plan")
# ci_plan_role_enabled     = true
# github_oidc_provider_arn = ""

# 선택 —— 스케줄을 따로 끌 때
# ec2_scheduler_enabled = false   # EC2 시작 · 중지와 가동 확인만 끔
# rds_scheduler_enabled = false   # RDS 시작 · 중지만 끔

# 기본값을 바꿀 때만
# scheduler_start_hour = 7
# scheduler_stop_hour  = 19
# rds_start_hour       = 6
# rds_start_minute     = 40
# rds_stop_hour        = 19
# rds_stop_minute      = 5
