<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Trade Service 간단한 로깅 설정 -->
    <property name="LOG_FILE" value="${LOG_FILE:-trade}"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Trade 패키지 로거 -->
    <logger name="com.muscat.trade" level="DEBUG"/>

    <!-- Feign 로거 -->
    <logger name="com.muscat.trade.infra.client" level="DEBUG"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>