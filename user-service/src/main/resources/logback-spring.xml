<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- User Service 간단한 로깅 설정 -->
    <property name="LOG_FILE" value="${LOG_FILE:-user}"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- User 패키지 로거 -->
    <logger name="com.muscat.user" level="DEBUG"/>

    <!-- Keycloak 로거 -->
    <logger name="org.keycloak" level="WARN"/>

    <!-- Mail 로거 -->
    <logger name="org.springframework.mail" level="INFO"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>