<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Market Data Service 간단한 로깅 설정 -->
    <property name="LOG_FILE" value="${LOG_FILE:-market-data}"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Market Data 패키지 로거 -->
    <logger name="com.muscat.marketdata" level="DEBUG"/>

    <!-- 외부 API 제공업체별 로거 -->
    <logger name="com.muscat.marketdata.provider" level="INFO"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>