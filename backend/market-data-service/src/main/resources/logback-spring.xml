<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Market Data Service 간단한 로깅 설정 -->
    <property name="LOG_FILE" value="${LOG_FILE:-market-data}"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{MM-dd HH:mm:ss} %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      config-server 가 logging.level 로 덮어쓴다. 여기 값은 config-server 를 못 붙었을 때의 기본이다.
      DEBUG 로 두면 붙지 못한 그 순간에 종목당 수십 줄이 쏟아진다.
      로컬에서 자세히 보려면 -Dlogging.level.com.muscat.marketdata=DEBUG 를 준다
    -->
    <logger name="com.muscat.marketdata" level="INFO"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>