{
  "name": "ggeolmuse-offline-notice",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",

  "workers_dev": false,

  // www 도 같이(없으면 Cloudflare 기본 화면)
  "routes": [
    { "pattern": "ggeolmuse.com/*", "zone_name": "ggeolmuse.com" },
    { "pattern": "www.ggeolmuse.com/*", "zone_name": "ggeolmuse.com" }
  ]
}
