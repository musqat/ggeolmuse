<?xml version="1.0" encoding="UTF-8"?>
<included>
    
    <!-- ========== 공통 프로퍼티 ========== -->
    <springProfile name="!prod">
        <property name="LOG_LEVEL" value="DEBUG"/>
        <property name="ROOT_LOG_LEVEL" value="INFO"/>
    </springProfile>
    
    <springProfile name="prod">
        <property name="LOG_LEVEL" value="INFO"/>
        <property name="ROOT_LOG_LEVEL" value="WARN"/>
    </springProfile>
    
    <property name="LOG_DIR" value="${LOG_PATH:-./logs}"/>
    <property name="SERVICE_NAME" value="${LOG_FILE:-service}"/>
    
    <!-- ========== 공통 패턴 ========== -->
    <property name="CONSOLE_PATTERN" 
        value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan([%X{userId:-anonymous}]) %yellow([%X{rid:-}]) %logger{36} - %msg%n"/>
    
    <property name="FILE_PATTERN" 
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{userId:-anonymous}] [%X{rid:-}] [%X{clientIp:-}] [%X{method:-}] [%X{endpoint:-}] %logger{36} - %msg%n"/>
    
    <property name="API_PATTERN" 
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{rid:-}] [%X{userId:-}] %X{method:-} %X{uri:-} %X{status:-} %X{duration:-}ms - %msg%n"/>
    
    <property name="ERROR_PATTERN" 
        value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{userId:-}] [%X{rid:-}] [%X{clientIp:-}] %logger{36} - %msg%n%ex"/>
    
    <!-- ========== 공통 Appenders ========== -->
    
    <!-- Console Appender (개발환경) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>
    
    <!-- Application Log File -->
    <appender name="APPLICATION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${SERVICE_NAME}.log</file>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${SERVICE_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Error Log File -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${SERVICE_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>${ERROR_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${SERVICE_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- API Log File -->
    <appender name="API_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${SERVICE_NAME}-api.log</file>
        <encoder>
            <pattern>${API_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${SERVICE_NAME}-api.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Slow Query Log File -->
    <appender name="SLOW_QUERY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${SERVICE_NAME}-slow-query.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{userId:-}] [%X{rid:-}] %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${SERVICE_NAME}-slow-query.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>
    
    <!-- ========== 공통 Logger 설정 ========== -->
    
    <!-- API Logger -->
    <logger name="API_LOGGER" level="INFO" additivity="false">
        <springProfile name="!prod">
            <appender-ref ref="API_FILE"/>
            <appender-ref ref="CONSOLE"/>
        </springProfile>
        <springProfile name="prod">
            <appender-ref ref="API_FILE"/>
        </springProfile>
    </logger>
    
    <!-- Slow Query Logger -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="SLOW_QUERY_FILE"/>
    </logger>
    
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="false">
        <appender-ref ref="SLOW_QUERY_FILE"/>
    </logger>
    
    <!-- ========== 외부 라이브러리 로그 레벨 조정 ========== -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.cloud.openfeign" level="INFO"/>
    <logger name="feign" level="INFO"/>
    <logger name="org.apache.http" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    
    <!-- 개발환경에서는 SQL 로그 활성화 -->
    <springProfile name="!prod">
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.springframework.cloud.openfeign" level="DEBUG"/>
        <logger name="feign" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
    </springProfile>
    
</included>