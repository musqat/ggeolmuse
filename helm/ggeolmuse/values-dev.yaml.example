secrets:
  enabled: true
  data:
    configServerUsername: "config"
    configServerPassword: "your-password-here"
    keycloakSecret: "your-keycloak-secret"
    keycloakAdminUsername: "admin"
    keycloakAdminPassword: "your-admin-password"
    keycloakClientSecret: "your-client-secret"
    keycloakTestUserPassword: "your-test-password"
    mailUsername: "your-email@example.com"
    mailPassword: "your-mail-app-password"
    mailFrom: "your-email@example.com"
    alphavantageApiKey: "your-alphavantage-api-key"
    koreaeximApiKey: "your-koreaexim-api-key"
