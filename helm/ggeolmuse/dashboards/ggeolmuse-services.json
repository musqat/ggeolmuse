  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "데이터 소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      },
      {
        "name": "job",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count, job)",
          "refId": "job"
        },
        "definition": "label_values(http_server_requests_seconds_count, job)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
