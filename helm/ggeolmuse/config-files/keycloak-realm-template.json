{
  "realm": "muscathan",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "ggeolmuse-client",
      "name": "GGeolmuse Application Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "redirectUris": [
        "http://localhost:*",
        "https://ggeolmuse.com/*",
        "http://gateway-server:8070/*",
        "http://user-service:8080/*",
        "http://trade-service:8081/*",
        "http://market-data-service:8083/*",
        "http://backtest-service:8082/*"
      ],
      "webOrigins": [
        "http://localhost:*",
        "https://ggeolmuse.com",
        "http://gateway-server:8070",
        "http://user-service:8080",
        "http://trade-service:8081",
        "http://market-data-service:8083",
        "http://backtest-service:8082",
        "+"
      ],
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    },
    {
      "clientId": "ggeolmuse-frontend",
      "name": "GGeolmuse Frontend Application",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "https://ggeolmuse.com/*",
        "https://ggeolmuse.com/oauth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "https://ggeolmuse.com",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "security-admin-console",
      "name": "${client_security-admin-console}",
      "rootUrl": "${authAdminUrl}",
      "baseUrl": "/admin/muscathan/console/",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "/admin/muscathan/console/*"
      ],
      "webOrigins": [
        "+"
      ],
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "fullScopeAllowed": false
    },
    {
      "clientId": "account",
      "name": "${client_account}",
      "baseUrl": "/realms/muscathan/account/",
      "enabled": true,
      "alwaysDisplayInConsole": true,
      "redirectUris": [
        "/realms/muscathan/account/*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "account-console",
      "name": "${client_account-console}",
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/muscathan/account/",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "/realms/muscathan/account/*"
      ],
      "webOrigins": [
        "+"
      ],
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "fullScopeAllowed": false
    },
    {
      "clientId": "broker",
      "name": "${client_broker}",
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "ggeolmuse-client",
        "roles": [
          "manage-users",
          "create-client",
          "manage-clients"
        ]
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard user role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false
      },
      {
        "name": "default-roles-muscathan",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ],
    "client": {
      "account": [
        {
          "name": "view-profile",
          "description": "${role_view-profile}",
          "composite": false
        },
        {
          "name": "manage-account",
          "description": "${role_manage-account}",
          "composite": true,
          "composites": {
            "client": {
              "account": [
                "manage-account-links"
              ]
            }
          }
        },
        {
          "name": "manage-account-links",
          "description": "${role_manage-account-links}",
          "composite": false
        }
      ]
    }
  },
  "users": [
    {
      "username": "service-account-ggeolmuse-client",
      "enabled": true,
      "serviceAccountClientId": "ggeolmuse-client",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "create-client",
          "manage-clients"
        ]
      }
    }
  ]
}
